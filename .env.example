# Server Configuration
PORT=3000
NODE_ENV=development

# Spam Protection & Rate Limiting
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum allowed submissions per window per IP (default: 5)
RATE_LIMIT_MAX=5

# Notification Alerts (Choose Email, Webhook, or both)

# Option A: SMTP Email Alerts (Nodemailer)
# Destination email address to receive incoming inquiries
ALERT_EMAIL_TO=deeeepakgm@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL_FROM="Portfolio Inquiries" <your-email@gmail.com>

# Option B: Instant Webhook Alerts (Discord, Slack, or Generic HTTP POST)
# Paste your Discord or Slack channel webhook URL here for instant push alerts
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
